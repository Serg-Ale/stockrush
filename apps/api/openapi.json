          "schema" : {
            "maxLength" : 255,
            "minLength" : 0,
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/CreateOrderRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/OrderResponse"
                }
              }
            },
            "description" : "Created"
          }
        },
        "security" : [ {
          "bearer" : [ ]
        } ],
        "tags" : [ "order-controller" ]
      }
    },
    "/orders/stream" : {
      "get" : {
        "operationId" : "streamOrders",
        "responses" : {
          "200" : {
            "content" : {
              "text/event-stream" : {
                "schema" : {
                  "type" : "string"
                }
              }
            },
            "description" : "OK"
          }
        },
        "security" : [ {
          "bearer" : [ ]
        } ],
        "tags" : [ "order-controller" ]
      }
