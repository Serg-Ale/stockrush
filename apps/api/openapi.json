              }
            },
            "description" : "Created"
          }
        },
        "tags" : [ "auth-controller" ]
      }
    },
    "/me" : {
      "get" : {
        "operationId" : "me",
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Me"
                }
              }
            },
            "description" : "OK"
          }
        },
        "security" : [ {
          "bearer" : [ ]
        } ],
        "tags" : [ "me-controller" ]
      }
    },
