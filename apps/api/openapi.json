{
  "components" : {
    "schemas" : {
      "CreateOrderRequest" : {
        "properties" : {
          "paymentToken" : {
            "maxLength" : 64,
            "minLength" : 0,
            "type" : "string"
          },
          "productId" : {
            "format" : "int64",
            "type" : "integer"
          },
          "quantity" : {
            "format" : "int32",
            "minimum" : 1,
            "type" : "integer"
          }
        },
        "required" : [ "productId" ],
        "type" : "object"
      },
      "Credentials" : {
        "properties" : {
          "email" : {
            "format" : "email",
            "minLength" : 1,
            "type" : "string"
          },
          "password" : {
            "maxLength" : 72,
            "minLength" : 8,
            "type" : "string"
          }
        },
        "required" : [ "email", "password" ],
        "type" : "object"
      },
      "DemoRaceResult" : {
        "properties" : {
          "buyers" : {
            "format" : "int32",
            "type" : "integer"
          },
          "failed" : {
            "format" : "int32",
            "type" : "integer"
          },
          "productId" : {
            "format" : "int64",
            "type" : "integer"
          },
          "rejected" : {
            "format" : "int32",
            "type" : "integer"
          },
          "sold" : {
            "format" : "int32",
            "type" : "integer"
          },
          "stockAfter" : {
            "format" : "int32",
            "type" : "integer"
          },
          "stockBefore" : {
            "format" : "int32",
            "type" : "integer"
          }
        },
        "type" : "object"
      },
      "Me" : {
        "properties" : {
          "email" : {
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "OrderResponse" : {
        "properties" : {
          "cancellationReason" : {
            "type" : "string"
          },
          "id" : {
            "format" : "int64",
            "type" : "integer"
          },
          "productId" : {
            "format" : "int64",
            "type" : "integer"
          },
          "quantity" : {
            "format" : "int32",
            "type" : "integer"
          },
          "status" : {
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "ProductResponse" : {
        "properties" : {
          "availableQuantity" : {
            "format" : "int32",
            "type" : "integer"
          },
          "id" : {
            "format" : "int64",
            "type" : "integer"
          },
          "name" : {
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "RaceRequest" : {
        "properties" : {
          "buyers" : {
            "format" : "int32",
            "minimum" : 1,
            "type" : "integer"
          },
          "paymentToken" : {
            "maxLength" : 64,
            "minLength" : 0,
            "type" : "string"
          },
          "productId" : {
            "format" : "int64",
            "type" : "integer"
          },
          "stock" : {
            "format" : "int32",
            "maximum" : 10000,
            "minimum" : 0,
            "type" : "integer"
          }
        },
        "required" : [ "productId" ],
        "type" : "object"
      },
      "RegisterResponse" : {
        "properties" : {
          "email" : {
            "type" : "string"
          },
          "id" : {
            "format" : "int64",
            "type" : "integer"
          }
        },
        "type" : "object"
      },
      "TokenResponse" : {
        "properties" : {
          "token" : {
            "type" : "string"
          }
        },
        "type" : "object"
      }
    },
    "securitySchemes" : {
      "bearer" : {
        "bearerFormat" : "JWT",
        "scheme" : "bearer",
        "type" : "http"
      }
    }
  },
  "info" : {
    "description" : "Orders with limited stock. Errors are RFC 9457 Problem Details.",
    "title" : "Stockrush API",
    "version" : "v1"
  },
  "openapi" : "3.1.0",
  "paths" : {
    "/admin/race" : {
      "post" : {
        "operationId" : "runDemoRace",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/RaceRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/DemoRaceResult"
                }
              }
            },
            "description" : "OK"
          }
        },
        "security" : [ {
          "bearer" : [ ]
        } ],
        "tags" : [ "demo-race-controller" ]
      }
    },
