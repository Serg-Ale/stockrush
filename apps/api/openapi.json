          "name" : "id",
          "required" : true,
          "schema" : {
            "format" : "int64",
            "type" : "integer"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/OrderResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "security" : [ {
          "bearer" : [ ]
        } ],
        "tags" : [ "order-controller" ]
      }
    },
    "/products" : {
      "get" : {
        "operationId" : "listProducts",
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
